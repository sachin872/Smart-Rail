# SMART RAIL AI - Environment Variables Template
ENVIRONMENT=development
PORT=8000

# Rate Limiting
RATE_LIMIT_ENABLED=true
READ_RPS=30
WRITE_RPS=10
ADMIN_RPS=5

# CRIS NTES/RTIS Gated Adapter Credentials (Optional - Leave blank for simulated sandbox fallback)
CRIS_AUTH_KEY=
CRIS_API_ENDPOINT=

# Weather API (Open-Meteo permitted free tier)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
